# ---------------------------------------------------------------------------
# Top Miles Logistics — environment variables
# Copy to .env.local for development. Never commit a filled-in copy.
# In production these are set in the Vercel dashboard (Project → Settings →
# Environment Variables), NOT in a file.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Vercel Postgres / Neon / Supabase all provide this value.
# Use the POOLED connection string for the app and the DIRECT one for migrations.
DATABASE_URL="postgresql://user:password@host:5432/topmiles?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/topmiles?sslmode=require"

# Canonical public URL of the site — used for SEO metadata, sitemap and
# Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://www.topmileslogistics.com"

# ---------------------------------------------------------------------------
# Admin dashboard authentication
# ---------------------------------------------------------------------------
# Email the admin logs in with.
ADMIN_EMAIL="admin@example.com"

# bcrypt hash of the admin password. NEVER store the plaintext password.
# Generate with:  npm run hash-password -- "your-strong-password"
#
# IMPORTANT: in a .env file every "$" must be escaped as "\$". Next.js expands
# variables in .env files, and an unescaped bcrypt hash like $2a$12$abc... is
# read as three empty variable references — the app will then reject every
# login. The hash-password script prints the correctly escaped value for you.
# Values set in the Vercel dashboard are NOT expanded; paste the raw hash there.
ADMIN_PASSWORD_HASH=\$2a\$12\$replace000this000with000a000real000bcrypt000hash00

# Secret used to sign the admin session cookie (HS256 JWT).
# Generate with:  openssl rand -base64 48
SESSION_SECRET="replace_with_a_long_random_string_at_least_32_chars"

# Salt used to hash applicant IP addresses for rate limiting and abuse
# detection. Hashing means raw IPs are never stored.
# Generate with:  openssl rand -base64 32
IP_HASH_SALT="replace_with_a_long_random_string"
