// Top Miles Logistics — data model
// Applicant data is sensitive. It is only ever read through authenticated
// admin routes; nothing in this schema is exposed publicly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ApplicationStatus {
  NEW
  REVIEWING
  CONTACTED
  HIRED
  NOT_A_FIT
  ARCHIVED
}

model Application {
  id String @id @default(cuid())

  // Idempotency key generated by the client form. A unique constraint here is
  // what stops a double-clicked button or a retried request from creating two
  // records for one submission.
  submissionToken String @unique

  // ---- Applicant identity -------------------------------------------------
  firstName      String
  lastName       String
  email          String
  // Lower-cased, trimmed email. Unique so one driver cannot flood the inbox
  // with repeat applications.
  emailNormalized String @unique
  phone          String
  // Digits only, used for duplicate detection and admin search.
  phoneNormalized String
  dateOfBirth    DateTime @db.Date

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  postalCode   String

  // ---- CDL ----------------------------------------------------------------
  cdlNumber       String
  cdlState        String
  cdlExpiration   DateTime @db.Date
  endorsements    String[] @default([])
  monthsCdlExperience Int
  monthsOtrExperience Int
  freightExperience   String[] @default([])

  // ---- Eligibility --------------------------------------------------------
  // 49 CFR 391.11 — the federal minimum age for interstate driving.
  isAtLeast21            Boolean
  legallyAuthorized      Boolean
  hasValidMedicalCard    Boolean
  medicalCardExpiration  DateTime? @db.Date
  canPassDrugScreen      Boolean
  inSapProgram           Boolean   @default(false)
  sapStep                String?
  canStayOut3To4Weeks    Boolean
  needsTransportAssistance Boolean @default(false)
  understands1099        Boolean

  // ---- Driving record -----------------------------------------------------
  hasAccidents        Boolean @default(false)
  accidents           Json    @default("[]")
  hasViolations       Boolean @default(false)
  violations          Json    @default("[]")
  licenseEverSuspended Boolean @default(false)
  licenseEverDenied    Boolean @default(false)
  recordExplanation    String?

  // ---- History (FMCSA 391.21: 3 yrs address, 10 yrs employment) -----------
  addressHistory    Json @default("[]")
  employmentHistory Json @default("[]")
  hasEmploymentGaps Boolean @default(false)
  employmentGapExplanation String?

  // ---- Consent / signature ------------------------------------------------
  certifiesAccurate       Boolean
  consentsToBackgroundCheck Boolean
  consentsToFmcsaQuery    Boolean
  signature               String
  signedAt                DateTime

  referralSource String?
  notes          String?

  // ---- Admin --------------------------------------------------------------
  status     ApplicationStatus @default(NEW)
  adminNotes String?

  // ---- Request metadata (privacy-preserving) ------------------------------
  // Raw IPs are never stored — only a salted hash, for abuse investigation.
  ipHash    String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([phoneNormalized])
  @@index([lastName])
}

/// Fixed-window rate limiting. Lives in the database so it works correctly
/// across serverless instances, where in-memory counters do not.
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}
